{
  "info": {
    "name": "ConnectX Onboarding V2 — Complete",
    "description": "Full E2E testing for the dynamic onboarding engine with 18 flows, 53 steps, 90+ questions. Covers all 4 main paths: Founder, Co-Founder, Team Member, Startup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "bearer_token", "value": "" },
    { "key": "session_id", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Use environment variable if available, fallback to collection variable",
          "const token = pm.environment.get('bearer_token') || pm.collectionVariables.get('bearer_token');",
          "if (token) { pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token }); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Auth — Login & Get Token",
      "item": [
        {
          "name": "Login (get bearer_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.environment.set('bearer_token', res.data.token);",
                  "  pm.collectionVariables.set('bearer_token', res.data.token);",
                  "  console.log('✅ Token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "id" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your@email.com\",\n  \"password\": \"yourpassword\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login/password", "host": ["{{base_url}}"], "path": ["auth","login","password"] }
          }
        }
      ]
    },
    {
      "name": "1. Create Session",
      "item": [
        {
          "name": "POST /onboarding/sessions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Session created', () => pm.response.to.have.status(201));",
                  "if (res.data && res.data.session_id) {",
                  "  pm.environment.set('session_id', res.data.session_id);",
                  "  pm.collectionVariables.set('session_id', res.data.session_id);",
                  "  console.log('Session ID: ' + res.data.session_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Accept-Language", "value": "id" }
            ],
            "url": { "raw": "{{base_url}}/onboarding/sessions", "host": ["{{base_url}}"], "path": ["onboarding","sessions"] }
          }
        }
      ]
    },
    {
      "name": "2. Get Current Step",
      "item": [
        {
          "name": "GET /sessions/{id}/current",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Step loaded', () => pm.response.to.have.status(200));",
                  "console.log('Current step: ' + pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Accept-Language", "value": "id" }
            ],
            "url": { "raw": "{{base_url}}/onboarding/sessions/{{session_id}}/current", "host": ["{{base_url}}"], "path": ["onboarding","sessions","{{session_id}}","current"] }
          }
        }
      ]
    },

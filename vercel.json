{
  "version": 2,
  "regions": ["sin1"],
  "framework": null,
  "buildCommand": "echo 'Skipping build - handled by vercel-php runtime'",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "^/build/(.*)$",
      "dest": "/public/build/$1"
    },
    {
      "src": "^/css/(.*)$",
      "dest": "/public/css/$1"
    },
    {
      "src": "^/js/(.*)$",
      "dest": "/public/js/$1"
    },
    {
      "src": "^/images/(.*)$",
      "dest": "/public/images/$1"
    },
    {
      "src": "^/fonts/(.*)$",
      "dest": "/public/fonts/$1"
    },
    {
      "src": "^/favicon\\.ico$",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "^/robots\\.txt$",
      "dest": "/public/robots.txt"
    },
    {
      "src": "^/livewire/(.*)$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/vendor/(.*)$",
      "dest": "/public/vendor/$1"
    },
    {
      "src": "^/storage/(.*)$",
      "dest": "/public/storage/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
